{
  "name": "kwikbus",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "turbo build",
    "check": "pnpm --filter @kwikbus/web build && biome check . && tsc --noEmit",
    "format": "biome check --write .",
    "test": "pnpm test:integration",
    "test:integration": "node --env-file=.env node_modules/vitest/vitest.mjs run tests/integration",
    "test:contention": "node --env-file=.env --import tsx scripts/prove-concurrency.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file=.env --import tsx scripts/seed.ts",
    "cf:check": "pnpm --filter @kwikbus/api build",
    "dev:peer": "wrangler dev -c apps/api/wrangler.jsonc --name kwikbus-api-peer --port 8788 --inspector-port 9235 --ip 127.0.0.1 --persist-to .wrangler/api-peer-state"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@cloudflare/workers-types": "5.20261025.1",
    "@types/express": "5.0.6",
    "@types/node": "24.12.0",
    "@types/pg": "8.20.0",
    "auth": "1.7.12",
    "drizzle-kit": "0.31.11",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  }
}
