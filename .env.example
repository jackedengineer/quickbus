# Obtain these from the dedicated KwikBus development Neon project.
DATABASE_URL=postgresql://role:password@your-endpoint-pooler.ap-southeast-1.aws.neon.tech/quickbus?sslmode=verify-full
MIGRATION_DATABASE_URL=postgresql://role:password@your-endpoint.ap-southeast-1.aws.neon.tech/quickbus?sslmode=verify-full
AUTH_SECRET=replace-with-a-random-32-byte-secret
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8787

DEPLOYMENT_ENV=local
MAILPIT_URL=http://127.0.0.1:8025
# Dedicated development database only; never set this for production.
ALLOW_DEV_FIXTURES=true
# Optional locally; required for Google sign-in in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production only, after kwikbus.in sender DNS is verified.
RESEND_API_KEY=
EMAIL_FROM=KwikBus <signin@kwikbus.in>
