{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kwikbus",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-25",
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false }
  },
  "services": [{ "binding": "API", "service": "kwikbus-api" }],
  "env": {
    "production": {
      "name": "kwikbus",
      "workers_dev": true,
      "preview_urls": false,
      "services": [{ "binding": "API", "service": "kwikbus-api" }]
    }
  }
}
